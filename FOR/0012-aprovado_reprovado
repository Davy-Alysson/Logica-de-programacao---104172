import os
os.system("cls")

soma = 0.0
media = float

for i in range(1,4):
    nota = float(input(f"Digite a {i}º nota:"))
    soma += nota
    media = soma / 3
if media >= 7:
    print("Aprovado")
    print(f"Média: {media:.1f}")
elif media <= 6 or media == 5:
    print("Recuperação")
    print(f"Média: {media:.1f}")
elif media <= 4:
    print("Reprovado")
    print(f"Média: {media:.1f}")


